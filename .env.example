############################################
# LLM PROVIDER SELECTION (plug-and-play)
# One of: ollama | groq | qwen_vllm
############################################
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Ollama (local dev/test) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Groq (API-based dev/test) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
# alt: mixtral-8x7b-32768, llama-3.1-8b-instant

# --- Qwen via vLLM / OpenAI-compatible server (production, multi-GPU) ---
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=Qwen/Qwen2.5-72B-Instruct
QWEN_API_KEY=not-needed

############################################
# EMBEDDINGS
# One of: sentence_transformers | ollama | openai_compatible
############################################
EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMERS_MODEL=BAAI/bge-small-en-v1.5
# used only if EMBEDDING_PROVIDER=openai_compatible (e.g. TEI/vLLM serving an embedder)
EMBED_BASE_URL=http://localhost:8001/v1
EMBED_MODEL=BAAI/bge-large-en-v1.5

############################################
# VECTOR STORE (ChromaDB)
############################################
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=documents
CHROMA_CACHE_COLLECTION=query_cache
RAG_TOP_K=5
CACHE_SIMILARITY_THRESHOLD=0.92

############################################
# HYBRID RETRIEVAL (BM25 + vector) + RERANK
############################################
HYBRID_SEARCH=true
BM25_WEIGHT=0.5
RRF_K=60
CANDIDATE_POOL_SIZE=30
RERANK_ENABLED=true
RERANK_TOP_K=5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

############################################
# RELATIONAL DATABASE (structured sector)
# One of: sqlite | postgresql | mysql
############################################
SQL_DIALECT=sqlite
SQLITE_PATH=./data/sqlite/app.db

# Used when SQL_DIALECT=postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Used when SQL_DIALECT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ragdb
MYSQL_USER=root
MYSQL_PASSWORD=root

ALLOW_WRITE_SQL=false
SQL_ROW_LIMIT=500

############################################
# MEMORY / CHECKPOINTING
############################################
CHECKPOINT_DB_PATH=./data/sqlite/checkpoints.db
CHAT_DB_PATH=./data/sqlite/chat.db
DEFAULT_THREAD_ID=default-session

############################################
# INGESTION
############################################
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DOCUMENTS_DIR=./data/documents
EXCEL_DIR=./data/excel

############################################
# OUTPUTS
############################################
PLOTS_OUTPUT_DIR=./data/outputs
LOG_LEVEL=INFO
